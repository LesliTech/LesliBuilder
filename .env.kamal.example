# Copy this file to .env.kamal. The destination is ignored by Git and loaded
# automatically when deployment commands are run through bin/kamal.
# Use the 1Password account ID or sign-in address accepted by `op --account`.
OP_ACCOUNT_ID=

# 1Password vault and item consumed by `kamal secrets fetch --from`.
# Example shape: VaultName/ItemName
OP_KAMAL_FROM=

# Full reference returned by Kamal for the fetched credential.
# Example shape: VaultName/ItemName/credential
OP_KAMAL_REGISTRY_PASSWORD_PATH=

# Optional public Google Tag Manager container ID for the demo deployment.
CREDENTIALS_PROVIDERS_GOOGLE_TAG_MANAGER=

# LesliAudit Cloudflare Traffic. The token may instead live in encrypted Rails
# credentials at cloudflare.analytics.token.
CLOUDFLARE_TRAFFIC_ENABLED=false
CLOUDFLARE_ANALYTICS_TOKEN=
CLOUDFLARE_ANALYTICS_ZONE_ID=
CLOUDFLARE_ANALYTICS_HOSTNAMES=demo.example.com
CLOUDFLARE_TRAFFIC_ACCOUNT_IDS=1
